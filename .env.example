# Environment Configuration Example for CrimeSense
# Copy to .env for custom configurations

# App Port & Host
HOST=127.0.0.1
PORT=8000

# Database Engine
# Default lightweight SQLite database (no external services needed):
DATABASE_URL=sqlite:///./crimesense.db

# For PostgreSQL deployment:
# DATABASE_URL=postgresql://crimesense_admin:crimesense_secure_password@localhost:5432/crimesense

# Spark Engine Mode: local[*] or standalone cluster URL
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g

# Academic Disclaimer Enforcement
ENFORCE_ACADEMIC_DISCLAIMER=true
